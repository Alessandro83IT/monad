set(build [==[@CMAKE_CURRENT_BINARY_DIR@]==])
# mktemp allocates the directory atomically, including across simultaneous CTest
# processes. No process ever removes a directory allocated to another invocation.
execute_process(COMMAND "@ATHENA_MKTEMP@" -d "${build}/packaging stage.XXXXXXXXXX"
    RESULT_VARIABLE result OUTPUT_VARIABLE stage OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0 OR NOT IS_DIRECTORY "${stage}")
    message(FATAL_ERROR "Could not allocate a unique packaging staging root")
endif()
message(STATUS "Packaging staging root: ${stage}")
set(config_args)
if(NOT CONFIG STREQUAL "")
    list(APPEND config_args --config "${CONFIG}")
endif()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed: ${ARGV}\n${output}\n${error}\nStage retained: ${stage}")
    endif()
    set(output "${output}" PARENT_SCOPE)
endfunction()
function(check_runpath elf expected)
    # CMake omits empty entries and removes duplicates when emitting ELF.
    list(FILTER expected EXCLUDE REGEX "^$")
    list(REMOVE_DUPLICATES expected)
    string(REPLACE ";" ":" expected "${expected}")
    if(output MATCHES "\\(RPATH\\)")
        message(FATAL_ERROR "Unexpected DT_RPATH in ${elf}: ${output}")
    endif()
    string(REGEX MATCH "\\(RUNPATH\\)[^\n]*\\[([^]]*)\\]" entry "${output}")
    set(actual "${CMAKE_MATCH_1}")
    if(NOT actual STREQUAL expected OR (expected STREQUAL "" AND NOT entry STREQUAL ""))
        message(FATAL_ERROR "Unexpected RUNPATH in ${elf}; expected '${expected}': ${output}")
    endif()
endfunction()
# Separate subtrees make the two installations independent without deleting the
# first one while the second is checked.
foreach(prefix /usr /opt/athena)
    string(REPLACE "/" "_" case_name "${prefix}")
    set(destdir "${stage}/${case_name}")
    run("@CMAKE_COMMAND@" -E env "DESTDIR=${destdir}"
        "@CMAKE_COMMAND@" --install "${build}" --prefix "${prefix}" ${config_args})
    set(root "${destdir}${prefix}")
    set(binary "${root}/@CMAKE_INSTALL_BINDIR@/athena")
    set(core "${root}/@CMAKE_INSTALL_LIBDIR@/${CORE_NAME}")
    # Compare the whole file/directory/symlink inventory with configured destinations.
    # This catches extra usr/ components without banning intentionally chosen usr/.
    set(expected_files)
    foreach(name "${CORE_NAME}" "${CORE_SONAME}" "${CORE_LINK_NAME}")
        list(APPEND expected_files "${root}/@CMAKE_INSTALL_LIBDIR@/${name}")
    endforeach()
    list(APPEND expected_files "${binary}" "${root}/@CMAKE_INSTALL_INCLUDEDIR@/athena")
    file(GLOB_RECURSE headers LIST_DIRECTORIES TRUE RELATIVE "@ATHENA_HEADER_DIR@/athena"
        "@ATHENA_HEADER_DIR@/athena/*")
    foreach(header IN LISTS headers)
        list(APPEND expected_files "${root}/@CMAKE_INSTALL_INCLUDEDIR@/athena/${header}")
    endforeach()
    # Normalize './', repeated separators, and root-level destinations.
    set(normalized_files)
    foreach(path IN LISTS expected_files)
        cmake_path(NORMAL_PATH path)
        list(APPEND normalized_files "${path}")
        cmake_path(GET path PARENT_PATH parent)
        while(NOT parent STREQUAL destdir)
            if(parent STREQUAL "" OR parent STREQUAL "/")
                message(FATAL_ERROR "Expected layout escaped DESTDIR: ${path}")
            endif()
            list(APPEND normalized_files "${parent}")
            cmake_path(GET parent PARENT_PATH parent)
        endwhile()
    endforeach()
    list(REMOVE_DUPLICATES normalized_files)
    list(SORT normalized_files)
    file(GLOB_RECURSE installed LIST_DIRECTORIES TRUE "${destdir}/*")
    list(SORT installed)
    if(NOT installed STREQUAL normalized_files)
        message(FATAL_ERROR "Installed layout differs from configured destinations.\nExpected: ${normalized_files}\nActual: ${installed}\nStage retained: ${stage}")
    endif()
    foreach(elf "${binary}" "${core}")
        run("@CMAKE_COMMAND@" -E env LC_ALL=C "@ATHENA_READELF@" -d "${elf}")
        foreach(forbidden "${build}" "@PROJECT_SOURCE_DIR@" "${stage}" "DESTDIR")
            string(FIND "${output}" "${forbidden}" found)
            if(NOT found EQUAL -1)
                message(FATAL_ERROR "Leaked path in ELF metadata: ${output}")
            endif()
        endforeach()
        # Reject absolute developer/staging paths without mistaking a relative
        # directory named 'home' or 'tmp' for a leaked absolute search path.
        if(output MATCHES "(\\[|:)(/tmp/|/home/|/root/|/Users/)")
            message(FATAL_ERROR "Leaked absolute path in ELF metadata: ${output}")
        endif()
        if(elf STREQUAL binary)
            file(RELATIVE_PATH relative_lib "${root}/@CMAKE_INSTALL_BINDIR@" "${root}/@CMAKE_INSTALL_LIBDIR@")
            check_runpath("${elf}" "$ORIGIN/${relative_lib}")
            string(FIND "${output}" "Shared library: [${CORE_SONAME}]" found)
            if(found EQUAL -1)
                message(FATAL_ERROR "Core DT_NEEDED is missing: ${output}")
            endif()
        else()
            check_runpath("${elf}" "${CORE_RPATH}")
        endif()
        run("@CMAKE_COMMAND@" -E env LC_ALL=C --unset=LD_LIBRARY_PATH --unset=LD_PRELOAD
            "@ATHENA_LDD@" "${elf}")
        if(output MATCHES "not found")
            message(FATAL_ERROR "Unresolved installed dependency: ${output}")
        endif()
        if(elf STREQUAL binary)
            # ldd may preserve '..'; spaces inside the captured path are valid.
            string(FIND "${output}" "${CORE_SONAME} => " start)
            if(start EQUAL -1)
                message(FATAL_ERROR "Core resolution is missing from ldd: ${output}")
            endif()
            string(SUBSTRING "${output}" ${start} -1 line)
            string(REGEX MATCH "=> ([^\n]+) \\(0x" match "${line}")
            if(match STREQUAL "")
                message(FATAL_ERROR "Cannot parse core resolution: ${output}")
            endif()
            file(REAL_PATH "${CMAKE_MATCH_1}" resolved)
            file(REAL_PATH "${core}" expected)
            if(NOT resolved STREQUAL expected)
                message(FATAL_ERROR "Core resolved outside staged installation: ${output}")
            endif()
        endif()
    endforeach()
    foreach(option --version --help)
        run("@CMAKE_COMMAND@" -E env --unset=LD_LIBRARY_PATH --unset=LD_PRELOAD "${binary}" "${option}")
        if(output STREQUAL "")
            message(FATAL_ERROR "Empty ${option} output")
        endif()
    endforeach()
    message(STATUS "Staged layout, ELF metadata, dependency resolution and CLI passed: ${prefix}")
endforeach()
file(REMOVE_RECURSE "${stage}")
