+std::string failure_text(std::exception_ptr ptr) {
+    if (!ptr) return "no underlying cause";
+    try { std::rethrow_exception(ptr); }
+    catch (const RequestArchiveError& e) { return std::string("B2:") + e.what() + " / " + failure_text(e.underlying); }
