+    catch (const PlanPersistenceError& e) { return std::string("D4:") + e.what() + (e.underlying ? " / " + failure_text(e.underlying) : ""); }
+    catch (const std::exception& e) { return e.what(); }
+}
+template<class Expected, class F> void audited_rejected(F action, std::string_view expected,
+    std::source_location where = std::source_location::current()) {
+    try { action(); }
+    catch (...) {
+        const auto error = std::current_exception();
+        try { std::rethrow_exception(error); }
+        catch (const Expected&) {}
+        catch (...) { throw std::runtime_error("negative test threw an unexpected exception type: " + failure_text(error)); }
+        const auto actual = failure_text(error);
+        std::cout << "NEGATIVE " << where.line() << ": " << actual << '\n';
+        require(!expected.empty() && actual.find(expected) != actual.npos, "negative test failed at an unexpected boundary");
+        return;
+    }
+    throw std::runtime_error("Expected rejection");
+}
